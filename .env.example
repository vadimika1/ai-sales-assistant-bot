APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_RUN_MODE=polling
BOT_DROP_PENDING_UPDATES=false
BOT_WEBHOOK_URL=
BOT_WEBHOOK_PATH=/telegram/webhook
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8081
API_BASE_URL=http://127.0.0.1:8080
API_SERVICE_TOKEN=your_random_service_token
API_RATE_LIMIT_SUGGEST_PER_MINUTE=30
API_RATE_LIMIT_FEEDBACK_PER_MINUTE=60
BOT_API_MAX_RETRIES=2
BOT_API_RETRY_BASE_MS=300
CRM_SYNC_URL=
CRM_SYNC_TOKEN=
CRM_SYNC_TIMEOUT_MS=5000
CRM_SYNC_MAX_RETRIES=2
CRM_SYNC_RETRY_BASE_MS=400
RAG_KB_PATH=./rag/knowledge_base.json
RAG_TOP_K=3
RAG_MIN_SCORE=1.0
USER_POLICIES_PATH=./user_policies.json
USER_DAILY_TOKEN_LIMIT=2500
USER_TOKEN_LIMIT_RESERVED_RESPONSE_TOKENS=280

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_FALLBACK_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=12000

# База данных:
# Вариант A (явный DSN):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ai_sales_assistant
# Вариант B (DSN собирается автоматически из POSTGRES_*):
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_sales_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
STORAGE_SQLITE_PATH=./assistant.db

# Backup (scripts/ops/postgres_backup.sh):
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=7
BACKUP_FILENAME_PREFIX=ai_sales_assistant
BACKUP_DB_SERVICE=db

# Monitoring + alerts (scripts/ops/monitor_stack.py):
MONITOR_READY_URL=http://127.0.0.1:8080/health/ready
MONITOR_READY_TIMEOUT_SECONDS=5
MONITOR_REQUIRED_SERVICES=api,bot,db
MONITOR_CPU_PERCENT_THRESHOLD=90
MONITOR_MEM_PERCENT_THRESHOLD=90
MONITOR_LOG_LOOKBACK_MINUTES=5
MONITOR_ERROR_LOG_THRESHOLD=1
MONITOR_ALERT_COOLDOWN_SECONDS=900
MONITOR_STATE_PATH=./.monitor_state.json
MONITOR_ALERT_TELEGRAM_BOT_TOKEN=
MONITOR_ALERT_TELEGRAM_CHAT_ID=
